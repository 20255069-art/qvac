---
import DatoInformalidad from "../components/DatoInformalidad.astro";
import Base from "../layouts/Base.astro";
import { contexto } from "../lib/datos.ts";

const PASOS = [
  {
    titulo: "1. Elige tu punto de partida",
    texto:
      "Selecciona el oficio en el que trabajas o relata tus tareas diarias en la entrevista con IA.",
  },
  {
    titulo: "2. Compara tu afinidad real",
    texto: "Descubre a qué ocupaciones afines puedes transitar y cuántas competencias ya dominas.",
  },
  {
    titulo: "3. Fortalece y postula",
    texto:
      "Accede a cursos gratuitos de Capacíta-T y conecta con vacantes en planilla de Empleos Perú.",
  },
];
---

<Base titulo="Inicio" descripcion="Descubre a qué trabajos afines puedes pasar con lo que ya sabes hacer, según el CNPO del MTPE.">
  <!-- Sección de Búsqueda y Orientación Estilo Gob.pe -->
  <section class="rounded-md border border-gray-200 bg-white p-5 sm:p-6 shadow-xs">
    <div class="space-y-1">
      <div class="flex flex-wrap items-center gap-2">
        <span class="gob-tag text-gray-500 uppercase">
          Plataforma Institucional MTPE
        </span>
        <span class="inline-flex items-center gap-1 rounded bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-800 border border-emerald-200">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
          Motor IA QVAC Local-First Activo
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">
        Reconversión Laboral en Gob.pe
      </h1>
      <p class="text-sm sm:text-base text-gray-600 max-w-3xl leading-relaxed">
        Lo que ya sabes hacer vale en otros trabajos. Identifica a qué oficios formales puedes acceder con tu experiencia previa, según el Catálogo Nacional de Perfiles Ocupacionales (CNPO).
      </p>
    </div>

    <!-- Barra de Búsqueda Oficial con Borde Ámbar de Gob.pe -->
    <form action="/ocupaciones/" method="get" class="mt-5 flex flex-col md:flex-row items-stretch gap-3">
      <div class="relative flex-1 flex items-center rounded-md border-2 border-amber-400 bg-white shadow-2xs focus-within:ring-2 focus-within:ring-amber-400/50">
        <input
          type="text"
          id="busqueda-orientacion"
          name="q"
          aria-label="Buscar ocupación o servicio"
          placeholder="¿Qué oficio o experiencia deseas reconvertir? (Ej. Almacén, Caja, Limpieza...)"
          class="w-full px-4 py-3 text-sm text-gray-800 placeholder-gray-400 focus:outline-none rounded-l-md"
        />
        <button
          type="submit"
          class="flex items-center justify-center bg-gray-900 px-5 py-3.5 text-white hover:bg-black rounded-r-sm transition cursor-pointer"
          title="Buscar en catálogo"
        >
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>

      <div class="flex gap-2 shrink-0">
        <div class="border border-gray-200 rounded-md bg-gray-50 px-3.5 py-2 text-xs flex flex-col justify-center">
          <span class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">Por Institución:</span>
          <span class="font-semibold text-gray-800">MTPE Perú</span>
        </div>
        <div class="border border-gray-200 rounded-md bg-gray-50 px-3.5 py-2 text-xs flex flex-col justify-center">
          <span class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">Por Catálogo:</span>
          <span class="font-semibold text-gray-800">9 Ocupaciones CNPO</span>
        </div>
      </div>
    </form>
  </section>

  <!-- Lista de Opciones Estilo Resultados de Búsqueda Gob.pe -->
  <section class="mt-6 rounded-md border border-gray-200 bg-white p-5 sm:p-6 shadow-xs">
    <div class="flex items-center justify-between border-b border-gray-200 pb-3">
      <div>
        <h2 class="text-lg font-bold text-gray-900">
          3 Opciones de Orientación Laboral
        </h2>
        <p class="text-xs text-gray-500">Selecciona la modalidad más adecuada para tu consulta</p>
      </div>
      <div class="hidden sm:flex items-center gap-2 text-xs text-gray-600">
        <span>Ordenar por:</span>
        <span class="border border-gray-300 rounded px-2.5 py-1 font-medium bg-gray-50 text-gray-800">
          Más relevante (MTPE)
        </span>
      </div>
    </div>

    <!-- Resultado 1: Catálogo CNPO -->
    <article class="py-5 border-b border-gray-200 space-y-1.5">
      <div class="flex items-center gap-2">
        <span class="text-xs text-gray-500 font-medium">MTPE - Ministerio de Trabajo y Promoción del Empleo</span>
      </div>
      <span class="block text-xs font-bold text-gray-700">Orientación, trámites y servicios</span>
      <h3 class="text-lg font-bold">
        <a href="/ocupaciones/" class="text-[#004884] hover:underline">
          Explorar el Catálogo de Ocupaciones CNPO (9 Ocupaciones y 72 Rutas)
        </a>
      </h3>
      <p class="text-sm text-gray-600 max-w-3xl leading-relaxed">
        Si ya conoces el puesto u oficio en el que laboras (almacén, cajero, limpieza, atención al cliente, etc.), consulta las competencias técnicas requeridas, compara puestos afines y conoce los cursos gratuitos sugeridos por <strong>Capacíta-T</strong>.
      </p>
      <div class="pt-2">
        <a href="/ocupaciones/" class="gob-btn-servicio">
          Ir al servicio
          <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 00-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0112.75 17h-8.5A2.25 2.25 0 012 14.75v-8.5A2.25 2.25 0 014.25 4h4a.75.75 0 010 1.5h-4z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M6.19 15.22a.75.75 0 001.06 0l6.97-6.97v2.5a.75.75 0 001.5 0v-4.5a.75.75 0 00-.75-.75h-4.5a.75.75 0 000 1.5h2.5l-6.97 6.97a.75.75 0 000 1.06z" clip-rule="evenodd"/></svg>
        </a>
      </div>
    </article>

    <!-- Resultado 2: Entrevista Guiada con IA QVAC -->
    <article class="py-5 border-b border-gray-200 space-y-1.5 bg-sky-50/20 -mx-3 sm:-mx-4 px-3 sm:px-4 rounded-md">
      <div class="flex items-center gap-2">
        <span class="text-xs text-gray-500 font-medium">MTPE - Ministerio de Trabajo y Promoción del Empleo</span>
        <span class="rounded bg-emerald-100 text-emerald-800 px-2 py-0.2 text-[10px] font-bold">Recomendado con IA</span>
      </div>
      <span class="block text-xs font-bold text-gray-700">Orientación con Inteligencia Artificial Soberana</span>
      <h3 class="text-lg font-bold">
        <a href="/entrevista/" class="text-[#004884] hover:underline">
          Entrevista Interactiva y Reconocimiento de Competencias con IA QVAC
        </a>
      </h3>
      <p class="text-sm text-gray-600 max-w-3xl leading-relaxed">
        Describe con tu propia voz o por escrito las tareas que realizas en tu día a día. El motor soberano <strong>Tether QVAC</strong> identifica tus competencias prácticas sin almacenar tus datos personales, genera tu Árbol de Habilidades, simula tu entrevista laboral y busca vacantes en tu departamento.
      </p>
      <div class="pt-2">
        <a href="/entrevista/" class="gob-btn-servicio">
          Ir al servicio
          <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 00-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0112.75 17h-8.5A2.25 2.25 0 012 14.75v-8.5A2.25 2.25 0 014.25 4h4a.75.75 0 010 1.5h-4z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M6.19 15.22a.75.75 0 001.06 0l6.97-6.97v2.5a.75.75 0 001.5 0v-4.5a.75.75 0 00-.75-.75h-4.5a.75.75 0 000 1.5h2.5l-6.97 6.97a.75.75 0 000 1.06z" clip-rule="evenodd"/></svg>
        </a>
      </div>
    </article>

    <!-- Resultado 3: Metodología e Insumos Oficiales -->
    <article class="py-5 space-y-1.5">
      <div class="flex items-center gap-2">
        <span class="text-xs text-gray-500 font-medium">MTPE - Información institucional y metodológica</span>
      </div>
      <span class="block text-xs font-bold text-gray-700">Metodología técnica y fuentes oficiales</span>
      <h3 class="text-lg font-bold">
        <a href="/acerca/" class="text-[#004884] hover:underline">
          Metodología de Reconversión, Insumos Oficiales y Arquitectura QVAC
        </a>
      </h3>
      <p class="text-sm text-gray-600 max-w-3xl leading-relaxed">
        Conoce la fórmula de afinidad ponderada, los 5 insumos oficiales del MTPE (CNPO, EDO 2026, Capacíta-T, Empleos Perú e INEI), los principios éticos del servicio y la arquitectura local-first soberana.
      </p>
      <div class="pt-2">
        <a href="/acerca/" class="gob-btn-servicio">
          Ir al servicio
          <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 00-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0112.75 17h-8.5A2.25 2.25 0 012 14.75v-8.5A2.25 2.25 0 014.25 4h4a.75.75 0 010 1.5h-4z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M6.19 15.22a.75.75 0 001.06 0l6.97-6.97v2.5a.75.75 0 001.5 0v-4.5a.75.75 0 00-.75-.75h-4.5a.75.75 0 000 1.5h2.5l-6.97 6.97a.75.75 0 000 1.06z" clip-rule="evenodd"/></svg>
        </a>
      </div>
    </article>
  </section>

  <!-- Diagnóstico de Informalidad y Exposición a IA -->
  <div class="mt-6">
    <DatoInformalidad contexto={contexto} />
  </div>

  <!-- Cómo funciona: 3 Pasos didácticos -->
  <section class="mt-6 rounded-md border border-gray-200 bg-white p-5 sm:p-6 shadow-xs">
    <h2 class="text-lg font-bold text-gray-900 border-b border-gray-100 pb-2">
      Cómo funciona el servicio de orientación
    </h2>
    <ol class="mt-4 grid gap-4 sm:grid-cols-3">
      {
        PASOS.map((paso) => (
          <li class="rounded-md border border-gray-200 bg-gray-50/60 p-4">
            <h3 class="text-sm font-bold text-gray-900 text-[#b91c1c]">{paso.titulo}</h3>
            <p class="mt-1.5 text-xs text-gray-600 leading-relaxed">{paso.texto}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-4 text-xs text-gray-500 bg-gray-50 p-3 rounded border border-gray-200">
      <strong>Nota institucional:</strong> Esta herramienta ofrece una orientación preliminar basada en coincidencias de competencias; no reemplaza la certificación oficial del MTPE ni emite títulos formales.
    </p>
  </section>
</Base>
