---
import Entrevista from "../components/islas/Entrevista.tsx";
import Base from "../layouts/Base.astro";
import { competencias, mapeo, ocupaciones } from "../lib/datos.ts";
import { competenciasPorOcupacion } from "../lib/sugerencias.ts";

const ocupacionesMinimas = ocupaciones.map(({ id, nombreCorto }) => ({ id, nombreCorto }));
const competenciasMinimas = competencias.map(({ id, nombre, tipo, palabrasClave }) => ({
  id,
  nombre,
  tipo,
  palabrasClave,
}));
---

<Base titulo="Cuéntanos tu experiencia" descripcion="Cuenta con tus palabras qué haces en tu trabajo y descubre qué competencias tienes.">
  <section class="caja">
    <h1>Cuéntanos tu experiencia</h1>
    <p class="mt-4">
      Responde con tus palabras, como se lo contarías a un amigo. No necesitas responder todo.
    </p>
  </section>
  <noscript>
    <p class="mt-4 rounded-base bg-aviso-fondo p-4 text-aviso-texto">
      Para usar la entrevista necesitas activar JavaScript. No guardamos tus respuestas.
    </p>
  </noscript>
  <div class="mt-6">
    <Entrevista client:load ocupaciones={ocupacionesMinimas} competencias={competenciasMinimas} mapeo={competenciasPorOcupacion(mapeo)} />
  </div>
</Base>
