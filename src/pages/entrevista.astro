---
import Entrevista from "../components/islas/Entrevista.tsx";
import Base from "../layouts/Base.astro";
import { competencias, cursos, mapeo, ocupaciones } from "../lib/datos.ts";
import { competenciasPorOcupacion } from "../lib/sugerencias.ts";

const ocupacionesMinimas = ocupaciones.map(({ id, nombreCorto }) => ({ id, nombreCorto }));
const competenciasMinimas = competencias.map(({ id, nombre, tipo, palabrasClave }) => ({
  id,
  nombre,
  tipo,
  palabrasClave,
}));
const cursosMinimos = Object.fromEntries(
  Object.entries(cursos).map(([id, curso]) => [
    id,
    { tema: curso.tema, url: curso.url, horasReferenciales: curso.horasReferenciales },
  ]),
);
---

<Base titulo="Entrevista Guiada con IA" descripcion="Cuenta con tus palabras qué haces en tu trabajo y descubre qué competencias del CNPO posees con IA local-first QVAC.">
  <section class="rounded-md border border-gray-200 bg-white p-5 sm:p-6 shadow-xs">
    <div class="space-y-1">
      <div class="flex flex-wrap items-center gap-2">
        <span class="gob-tag text-gray-500 uppercase">
          ORIENTACIÓN CON INTELIGENCIA ARTIFICIAL SOBERANA · ETAPA 3
        </span>
        <span class="inline-flex items-center gap-1 rounded bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-800 border border-emerald-200">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
          Escudo de Privacidad Activo
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">
        Entrevista Guiada y Reconocimiento de Competencias
      </h1>
      <p class="text-sm sm:text-base text-gray-600 max-w-3xl leading-relaxed">
        Describe con tus propias palabras qué haces en tu jornada laboral, ya sea con tu voz o escribiendo. El motor de IA local-first <strong>QVAC</strong> identificará tus competencias reales frente al Catálogo Nacional del MTPE.
      </p>
    </div>
  </section>
  <noscript>
    <p class="mt-4 rounded-base bg-aviso-fondo p-4 text-aviso-texto">
      Para usar la entrevista necesitas activar JavaScript. No guardamos tus respuestas.
    </p>
  </noscript>
  <div class="mt-6">
    <Entrevista
      client:load
      ocupaciones={ocupacionesMinimas}
      competencias={competenciasMinimas}
      mapeo={competenciasPorOcupacion(mapeo)}
      cursos={cursosMinimos}
    />
  </div>
</Base>
