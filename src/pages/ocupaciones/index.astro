---
import TarjetaOcupacion from "../../components/TarjetaOcupacion.astro";
import Base from "../../layouts/Base.astro";
import { ocupaciones } from "../../lib/datos.ts";
---

<Base titulo="Elige tu ocupación" descripcion="Elige la ocupación en la que trabajas para ver a qué trabajos afines puedes pasar.">
  <section class="caja">
    <h1>Elige tu ocupación</h1>
    <p class="mt-4">
      Toca la ocupación en la que trabajas o trabajaste. Te mostraremos los trabajos afines según el CNPO.
    </p>
    <p class="mt-2 text-texto-suave">
      De los perfiles prioritarios del MTPE, este prototipo incluye cajeros, limpieza y almacén. Aún no incluye auxiliares administrativos ni vendedores de tienda.
    </p>
  </section>
  <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {ocupaciones.map((ocupacion) => <TarjetaOcupacion ocupacion={ocupacion} />)}
  </ul>
</Base>
