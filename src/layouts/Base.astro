---
import LogoGobPe from "../components/LogoGobPe.astro";
import PiePagina from "../components/PiePagina.astro";
import RutaJerarquica from "../components/RutaJerarquica.astro";
import "../styles/global.css";

interface Props {
  titulo: string;
  descripcion: string;
}

const { titulo, descripcion } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} | Reconversión Laboral - MTPE</title>
    <meta name="description" content={descripcion} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-superficie text-texto antialiased min-h-screen flex flex-col">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:shadow-md focus:border focus:border-gray-300">Saltar al contenido</a>
    
    <!-- Cabecera Institucional Gob.pe Oficial -->
    <header class="border-b border-gray-200 bg-white">
      <div class="mx-auto flex max-w-contenido flex-wrap items-center justify-between gap-3 px-4 py-3">
        <div class="flex items-center gap-3">
          <!-- Logotipo Oficial Gob.pe -->
          <a href="/" class="flex items-center text-gray-900 no-underline hover:opacity-95 transition" title="Ir a la portada de gob.pe">
            <LogoGobPe class="h-8 sm:h-9 w-auto" />
          </a>

          <div class="hidden sm:block h-7 w-px bg-gray-300"></div>

          <div class="flex flex-col">
            <span class="text-xs font-bold text-gray-800 leading-tight">Ministerio de Trabajo y Promoción del Empleo</span>
            <span class="text-[11px] text-gray-500">Plataforma de Reconversión Laboral (CNPO)</span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1 rounded bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-xs font-semibold text-emerald-800">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
            Tether QVAC Activo
          </span>
          <a
            href="/acerca/"
            class="text-xs font-semibold text-[#004884] hover:underline px-2 py-1"
          >
            Metodología
          </a>
        </div>
      </div>
    </header>

    <!-- Miga de Pan (Breadcrumb) Oficial Gob.pe -->
    <div class="border-b border-gray-100 bg-white px-4 py-1.5 text-xs">
      <div class="mx-auto flex max-w-contenido items-center gap-1.5 text-gray-500 overflow-x-auto whitespace-nowrap">
        <a href="/" class="text-[#004884] hover:underline">Inicio</a>
        <span class="text-gray-400">&gt;</span>
        <span class="text-gray-500">El Estado</span>
        <span class="text-gray-400">&gt;</span>
        <a href="/" class="text-[#004884] hover:underline">MTPE</a>
        <span class="text-gray-400">&gt;</span>
        <span class="font-medium text-gray-800">{titulo}</span>
      </div>
    </div>

    <!-- Barra de Pestañas Gob.pe (Etapas 1, 2, 3, 4) -->
    <RutaJerarquica posicion="arriba" />

    <main id="contenido" tabindex="-1" class="mx-auto max-w-contenido w-full flex-1 px-4 py-6">
      <slot />
    </main>

    <!-- Guía de Siguiente Paso al pie -->
    <RutaJerarquica posicion="abajo" />

    <PiePagina />
  </body>
</html>
