---
interface Props {
  posicion: "arriba" | "abajo";
}

const { posicion } = Astro.props;
const rutaActual = Astro.url.pathname;

const ETAPAS = [
  {
    numero: 1,
    titulo: "1. Portada MTPE",
    subtitulo: "Inicio y diagnóstico",
    href: "/",
    activo: rutaActual === "/",
  },
  {
    numero: 2,
    titulo: "2. Catálogo CNPO",
    subtitulo: "Ocupaciones y rutas",
    href: "/ocupaciones/",
    activo: rutaActual.startsWith("/ocupaciones") || rutaActual.startsWith("/transicion"),
  },
  {
    numero: 3,
    titulo: "3. Entrevista QVAC",
    subtitulo: "Tu experiencia con IA",
    href: "/entrevista/",
    activo: rutaActual.startsWith("/entrevista"),
  },
  {
    numero: 4,
    titulo: "4. Metodología e Insumos",
    subtitulo: "Fuentes MTPE e INEI",
    href: "/acerca/",
    activo: rutaActual.startsWith("/acerca"),
  },
];

const indiceActivo = Math.max(
  0,
  ETAPAS.findIndex((e) => e.activo),
);
const etapaAnterior = indiceActivo > 0 ? ETAPAS[indiceActivo - 1] : null;
const etapaSiguiente = indiceActivo < ETAPAS.length - 1 ? ETAPAS[indiceActivo + 1] : null;
---

{
  posicion === "arriba" ? (
    <nav
      aria-label="Navegación por pestañas Gob.pe"
      class="border-b border-gray-300 bg-[#e5e7eb] px-2 sm:px-4"
    >
      <div class="mx-auto max-w-contenido">
        <ul class="flex flex-nowrap items-end gap-1 overflow-x-auto text-sm scrollbar-none pt-2">
          {ETAPAS.map((etapa) => (
            <li class="shrink-0">
              <a
                href={etapa.href}
                aria-current={etapa.activo ? "page" : undefined}
                class:list={[
                  "inline-flex flex-col items-center justify-center px-4 py-2.5 text-center text-xs sm:text-sm transition-all duration-150 no-underline",
                  etapa.activo
                    ? "rounded-t border-b-4 border-[#b91c1c] bg-white font-bold text-[#b91c1c] shadow-xs"
                    : "border-b-4 border-transparent font-medium text-gray-700 hover:bg-white/60 hover:text-gray-900",
                ]}
              >
                <span class="truncate">{etapa.titulo}</span>
                <span class="hidden md:inline text-[11px] font-normal opacity-85">{etapa.subtitulo}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  ) : (
    <aside
      aria-label="Siguiente paso del recorrido"
      class="mx-auto max-w-contenido px-4 pb-8 pt-4"
    >
      <div class="rounded-md border border-gray-200 bg-white p-5 shadow-xs">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="space-y-1">
            <span class="gob-tag text-gray-500">
              ORIENTACIÓN DEL RECORRIDO · ETAPA {indiceActivo + 1} DE {ETAPAS.length}
            </span>
            {indiceActivo === 0 && (
              <>
                <h2 class="text-base sm:text-lg font-bold text-gray-900">
                  ¿Cómo deseas continuar tu orientación?
                </h2>
                <p class="text-sm text-gray-600 max-w-2xl leading-relaxed">
                  Puedes explorar el <strong>Catálogo de Ocupaciones del MTPE</strong> para contrastar requisitos y vacantes, o iniciar la <strong>Entrevista Interactiva con IA QVAC</strong> para transcribir tus tareas diarias con voz o texto.
                </p>
              </>
            )}
            {indiceActivo === 1 && (
              <>
                <h2 class="text-base sm:text-lg font-bold text-gray-900">
                  Siguiente paso: Traduce tu experiencia ciudadana con IA QVAC
                </h2>
                <p class="text-sm text-gray-600 max-w-2xl leading-relaxed">
                  ¿Realizas labores de múltiples oficios o deseas una recomendación personalizada? Cuéntanos tu jornada en la <strong>Entrevista con IA QVAC</strong> para estructurar tu Árbol de Habilidades.
                </p>
              </>
            )}
            {indiceActivo === 2 && (
              <>
                <h2 class="text-base sm:text-lg font-bold text-gray-900">
                  Siguiente paso: Conoce la Metodología e Insumos Oficiales
                </h2>
                <p class="text-sm text-gray-600 max-w-2xl leading-relaxed">
                  Revisa el sustento técnico basado en el <strong>CNPO del MTPE</strong>, los datos de la <strong>EDO 2026</strong>, los cursos de <strong>Capacíta-T</strong> y la inferencia soberana de <strong>Tether QVAC</strong>.
                </p>
              </>
            )}
            {indiceActivo === 3 && (
              <>
                <h2 class="text-base sm:text-lg font-bold text-gray-900">
                  ¡Orientación completa! Puedes consultar cualquier módulo
                </h2>
                <p class="text-sm text-gray-600 max-w-2xl leading-relaxed">
                  Tienes a tu disposición el catálogo completo de ocupaciones, el diagnóstico de informalidad laboral y el simulador de entrevistas cuantas veces lo requieras.
                </p>
              </>
            )}
          </div>

          <div class="flex flex-wrap items-center gap-2.5">
            {etapaAnterior && (
              <a
                href={etapaAnterior.href}
                class="inline-flex items-center gap-1.5 rounded border border-gray-300 bg-gray-50 px-3.5 py-2 text-xs sm:text-sm font-semibold text-gray-700 hover:bg-gray-100 no-underline transition"
              >
                ← {etapaAnterior.titulo}
              </a>
            )}

            {indiceActivo === 0 && (
              <a
                href="/entrevista/"
                class="gob-btn-servicio text-xs sm:text-sm"
              >
                Ir a 3. Entrevista QVAC ↗
              </a>
            )}

            {etapaSiguiente ? (
              <a
                href={etapaSiguiente.href}
                class="inline-flex items-center gap-1.5 rounded bg-[#b91c1c] px-4 py-2 text-xs sm:text-sm font-bold text-white hover:bg-[#991b1b] no-underline shadow-xs transition"
              >
                Continuar a {etapaSiguiente.titulo} →
              </a>
            ) : (
              <a
                href="/"
                class="inline-flex items-center gap-1.5 rounded bg-[#b91c1c] px-4 py-2 text-xs sm:text-sm font-bold text-white hover:bg-[#991b1b] no-underline shadow-xs transition"
              >
                ↺ Volver al Inicio
              </a>
            )}
          </div>
        </div>
      </div>
    </aside>
  )
}
