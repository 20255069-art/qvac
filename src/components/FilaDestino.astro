---
import type { Transicion } from "../lib/afinidad.ts";
import type { Ocupacion } from "../lib/esquemas.ts";
import IconoOcupacion from "./IconoOcupacion.astro";
import InsigniaDemanda from "./InsigniaDemanda.astro";

interface Props {
  transicion: Transicion;
  destino: Ocupacion;
  origenId: string;
}

const { transicion, destino, origenId } = Astro.props;
const porcentaje = Math.round(transicion.cobertura * 100);
---

<li data-testid="destino" data-afinidad={transicion.afinidad} class="caja tarjeta-enlace con-icono hover:border-[#004884] transition">
  <div class="flex items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <IconoOcupacion id={destino.id} tamano={48} />
      <div>
        <span class="gob-tag text-gray-500">OCUPACIÓN DE DESTINO · CNPO</span>
        <h3 class="text-base font-bold text-gray-900">
          <span class="text-[#004884]">{destino.nombreCorto}</span>
        </h3>
      </div>
    </div>
    <span class="inline-flex items-center rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 text-xs font-bold text-emerald-800">
      {porcentaje} % afinidad
    </span>
  </div>

  <p class="mt-3 text-sm text-gray-700">Los perfiles comparten el <strong>{porcentaje} %</strong> de las competencias requeridas.</p>
  <div class="mt-2 h-2.5 w-full rounded-full bg-gray-100 overflow-hidden" aria-hidden="true">
    <div class="h-2.5 rounded-full bg-emerald-600" style={`width: ${porcentaje}%`}></div>
  </div>

  <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-gray-100 pt-2.5 text-xs text-gray-500">
    <div class="flex items-center gap-2">
      <InsigniaDemanda nivel={destino.demanda.nivel} />
      <span>·</span>
      <span>{transicion.compartidas.length} competencias compartidas</span>
      <span>·</span>
      <span>{transicion.porFortalecer.length} por fortalecer</span>
    </div>
    <div>
      <a
        class="enlace-tarjeta text-xs font-bold text-[#004884] hover:underline inline-flex items-center gap-1"
        href={`/transicion/${origenId}/${destino.id}/`}
        aria-label={`Ver el detalle de la transición a ${destino.nombreCorto}`}
      >
        Ver ruta de transición ↗
      </a>
    </div>
  </div>
</li>
