---
import type { Ocupacion } from "../lib/esquemas.ts";
import IconoOcupacion from "./IconoOcupacion.astro";

interface Props {
  ocupacion: Ocupacion;
}

const { ocupacion } = Astro.props;
---

<li class="rounded-md border border-gray-200 bg-white p-4 shadow-2xs hover:border-[#004884] hover:shadow-xs transition flex gap-3.5 items-start">
  <div class="shrink-0 pt-0.5">
    <IconoOcupacion id={ocupacion.id} tamano={56} />
  </div>
  <div class="min-w-0 flex-1 flex flex-col justify-between h-full">
    <div>
      <span class="inline-block rounded bg-gray-100 px-2 py-0.5 text-[11px] font-bold text-gray-700 uppercase">
        CNPO {ocupacion.codigo}
      </span>
      <h2 class="mt-1 text-base font-bold">
        <a class="text-[#004884] hover:underline" href={`/ocupaciones/${ocupacion.id}/`}>
          {ocupacion.nombreCorto}
        </a>
      </h2>
      <p class="mt-1 text-xs text-gray-600 line-clamp-2 leading-relaxed">
        Puestos: {ocupacion.puestos.join(", ")}
      </p>
    </div>
    <div class="mt-3 pt-2 border-t border-gray-100">
      <a href={`/ocupaciones/${ocupacion.id}/`} class="text-xs font-semibold text-[#004884] hover:underline inline-flex items-center gap-1">
        Ver rutas afines →
      </a>
    </div>
  </div>
</li>
