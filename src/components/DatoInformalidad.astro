---
import type { Contexto } from "../lib/esquemas.ts";
import { formatearPorcentaje } from "../lib/formato.ts";

interface Props {
  contexto: Contexto;
}

const { contexto } = Astro.props;
---

<div class="rounded-base border border-borde bg-superficie p-4">
  <p class="text-4xl font-bold text-primario">{formatearPorcentaje(contexto.informalidadNacional)}</p>
  <p>de las personas que trabajan en el Perú tiene un empleo informal ({contexto.periodo}).</p>
  <p class="text-base text-texto-suave">Fuente: {contexto.fuente}</p>
</div>
